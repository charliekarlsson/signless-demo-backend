generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant?
}

model Merchant {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  displayName  String
  slug         String     @unique
  primaryEmail String
  supportEmail String?
  branding     Json
  webhookUrl   String?
  onboardingStatus   OnboardingStatus @default(NOT_STARTED)
  onboardingChecklist Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  checkouts    Checkout[]
  apiKeys      ApiKey[]
  payoutWallets     PayoutWallet[]
  complianceProfile MerchantCompliance?
  documents         MerchantDocument[]
}

model Checkout {
  id           String    @id @default(cuid())
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id])
  name         String
  slug         String
  description  String?
  amountMinor  BigInt
  currency     String
  scheme       String
  network      String
  assetAddress String
  metadata     Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([merchantId, slug])
}

model ApiKey {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  key         String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
}

model PayoutWallet {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  network      String
  asset        String
  address      String
  label        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([merchantId, isPrimary])
}

model MerchantCompliance {
  id                 String   @id @default(cuid())
  merchantId         String   @unique
  merchant           Merchant @relation(fields: [merchantId], references: [id])
  legalName          String
  countryCode        String   @db.VarChar(2)
  registrationNumber String?
  contactName        String
  contactPhone       String?
  taxId              String?
  kycStatus          String   @default("pending")
  submittedAt        DateTime
  reviewedAt         DateTime?
  reviewerId         String?
  notes              String?
}

model MerchantDocument {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  type         String
  storageKey   String
  status       String   @default("pending")
  uploadedAt   DateTime @default(now())
  processedAt  DateTime?
  checksum     String?
}

enum OnboardingStatus {
  NOT_STARTED
  COLLECT_PROFILE
  COLLECT_PAYOUT
  COLLECT_COMPLIANCE
  REVIEW
  APPROVED
  REJECTED
}
