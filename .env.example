# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL connection string)
# Local development uses docker-compose services defined in this repo
DATABASE_URL="postgresql://signless:signless@localhost:5432/signless?schema=public"

# Authentication
JWT_SECRET="replace-with-strong-secret"

# CORS origins (comma-separated). Use * to allow any origin.
CORS_ORIGINS=http://localhost:5173

# Optional defaults referenced by the builder exports and watcher snippet
RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
RPC_PRIMARY=https://sepolia.base.org
RPC_FALLBACK=https://rpc.ankr.com/base_sepolia
